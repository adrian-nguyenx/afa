# Copy this file to .env (same folder) and fill in your own values. .env is git-ignored: never commit it.
# In Phase 4 the same names go into GitHub → Settings → Secrets and variables → Actions → Secrets.

# Gmail SMTP: use an App Password (Google Account → Security → 2-Step Verification → App passwords), not your normal password.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# One or more recipients, comma-separated
NOTIFY_EMAIL_TO=

# Telegram: create a bot with @BotFather, send /start to it, then run
#   python automation/run.py --telegram-whoami
# to see your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: Claude API key, only used to translate important international headlines into Vietnamese
# (Claude Haiku 5.5, Batch API, capped in automation/config.json). Billed separately from a Claude Pro plan.
# Leave empty to skip translation: international stories are then not shown.
ANTHROPIC_API_KEY=
